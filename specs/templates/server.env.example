# <server-name> の server/.env
# 秘密情報を含む。リポジトリに含めない。MCP サーバを動かす OS ユーザだけが読めるようにする。

# 待ち受け（開発時は 127.0.0.1。本番も nginx の背後で 127.0.0.1）
MCP_HOST=127.0.0.1
MCP_PORT=9001

# 公開 URL（OAuth の発行者・トークンの対象。nginx 経由の公開 URL と完全に一致させる）
MCP_PUBLIC_URL=http://127.0.0.1:9001

# 許可する Origin（カンマ区切り。* は使わない）
MCP_ALLOWED_ORIGINS=http://localhost

# OAuth: サインインのパスフレーズのハッシュ（scripts/ の運用コマンドで作る。平文は置かない）
MCP_SIGNIN_PASSPHRASE_HASH=
# OAuth: サインインの連続失敗の上限と、上限に達したときに受け付けを止める時間（分）
MCP_SIGNIN_MAX_FAILURES=5
MCP_SIGNIN_LOCK_MINUTES=15
# OAuth: トークンの有効期間（リフレッシュトークンの 0 は無期限）
MCP_ACCESS_TOKEN_TTL_MINUTES=60
MCP_REFRESH_TOKEN_TTL_DAYS=90
# OAuth: DCR で登録を許すリダイレクト URI（カンマ区切り。完全一致。ループバックはポート番号を問わない）
MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback

# 認証の状態（SQLite）の保存先ディレクトリ
MCP_DATA_DIR=data

# サイトの構成ファイル（既定: server/sites.toml）
MCP_SITES_FILE=sites.toml

# サイトごとの Web アプリの API キー（SITE_<SITE>_API_KEY。sites.toml の各サイトに 1 つ）
SITE_HOME_API_KEY=

# Web アプリの API 呼び出しのタイムアウト（秒）
WEBAPP_TIMEOUT_SECONDS=10

# ログローテーション
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
